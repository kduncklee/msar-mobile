{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-jsx",
    "baseUrl": "./src/",
    "paths": {
      "@/*": ["./*"],
      "@modules/*": ["../modules/*"],
      "@assets/*": ["./assets/*"],
      "@components/*": ["./components/*"],
      "@remote/*": ["./remote/*"],
      "@storage/*": ["./storage/*"],
      "@styles/*": ["./styles/*"],
      "@utility/*": ["./utility/*"]
    },
    "strictNullChecks": true
  },
  "exclude": [
    "packages/notification-service-expo-plugin/examples",
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js"
  ]
}
