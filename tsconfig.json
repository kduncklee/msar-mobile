{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@modules/*": ["./modules/*"],
      "@assets/*": ["./src/assets/*"],
      "@components/*": ["./src/components/*"],
      "@remote/*": ["./src/remote/*"],
      "@storage/*": ["./src/storage/*"],
      "@styles/*": ["./src/styles/*"],
      "@utility/*": ["./src/utility/*"],
      "*": ["./src/*"]
    },
    "types": ["jest"],
    "strict": false,
    "strictNullChecks": true
  },
  "exclude": [
    "packages/notification-service-expo-plugin/examples",
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js"
  ]
}
